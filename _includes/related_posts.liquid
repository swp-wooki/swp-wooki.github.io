{% if page.recommendations.size > 0 %}
  <section class="related-reading" aria-labelledby="related-title">
    <div class="section-heading">
      <h2 id="related-title">Related posts</h2>
    </div>
    <div class="related-grid">
      {% for post in page.recommendations %}
        <article>
          <p class="recommendation-reason">{{ post.reason | escape }}</p>
          <h3>
            <a href="{{ post.url | relative_url }}">{{ post.title | escape }}</a>
          </h3>
          {% if post.description %}
            <p>{{ post.description | escape }}</p>
          {% endif %}
          <span class="note-reading-time">{{ post.reading_minutes }} min read</span>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
