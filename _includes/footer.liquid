<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div>
      <a class="footer-name" href="{{ '/' | relative_url }}">
        {{- site.first_name }}
        {{ site.last_name -}}
      </a>
      <small>© {{ site.time | date: '%Y' }} · Built with Jekyll &amp; al-folio</small>
    </div>
    <nav aria-label="Footer">
      <a href="mailto:{{ site.data.socials.email }}">Email</a><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a
      ><a href="{{ '/feed.xml' | relative_url }}">RSS</a><a href="{{ '/talk/' | relative_url }}">Talks</a
      ><a href="{{ '/travel/' | relative_url }}">Travel</a>
    </nav>
  </div>
</footer>
