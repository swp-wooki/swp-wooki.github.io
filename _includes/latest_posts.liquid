<div class="note-list">
  {% assign latest_limit = page.latest_posts.limit | default: 3 %}
  {% for post in site.posts limit: latest_limit %}
    <article class="note-row">
      <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %d, %Y' }}</time>
      <div>
        <h3>
          <a href="{% if post.redirect %}{{ post.redirect | relative_url }}{% else %}{{ post.url | relative_url }}{% endif %}">{{ post.title }}</a>
        </h3>
        {% if post.description %}
          <p>{{ post.description | escape }}</p>
        {% endif %}
      </div>
      <span class="note-reading-time">{{ post.reading_minutes }} min read</span>
    </article>
  {% endfor %}
</div>
