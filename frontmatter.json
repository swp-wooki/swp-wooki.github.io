{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "jekyll",
  "frontMatter.site.baseURL": "https://swp-wooki.github.io",
  "frontMatter.content.pageFolders": [
    {
      "title": "Drafts",
      "path": "[[workspace]]/_drafts",
      "contentTypes": [
        "default"
      ]
    },
    {
      "title": "Published Posts",
      "path": "[[workspace]]/_posts",
      "contentTypes": [
        "default"
      ],
      "disableCreation": true
    }
  ],
  "frontMatter.content.publicFolder": "assets/img/blog",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "fileType": "md",
      "template": "[[workspace]]/_templates/study-note.md",
      "fields": [
        {
          "title": "Layout",
          "name": "layout",
          "type": "string",
          "default": "post",
          "hidden": true
        },
        {
          "title": "제목",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "글 요약",
          "name": "description",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "카테고리",
          "name": "categories",
          "type": "categories",
          "required": true
        },
        {
          "title": "태그",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "댓글",
          "name": "giscus_comments",
          "type": "boolean",
          "default": true
        },
        {
          "title": "관련 글",
          "name": "related_posts",
          "type": "boolean",
          "default": true
        }
      ]
    }
  ]
}