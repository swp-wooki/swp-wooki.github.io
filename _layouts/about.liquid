---
layout: default
---
<div class="academic-home">
  <header class="home-hero">
    <div class="home-hero-main">
      <p class="eyebrow">Mathematics · Optimization · Computation</p>
      <h1>
        Seongwook<br>
        <span>Park.</span>
      </h1>
      <p class="home-position">
        BS–MS Integrated Student<br>
        <a href="https://finx.hanyang.ac.kr">FINX Lab</a> · Hanyang University
      </p>
      <div class="home-links">
        <a class="button-primary" href="{{ '/blog/' | relative_url }}">Explore my notes <span aria-hidden="true">↗</span></a>
        <a href="{{ '/cv/' | relative_url }}">Curriculum vitae <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="home-introduction">
      <p class="eyebrow">About me</p>
      {{ content }}
      <a class="contact-link" href="mailto:{{ site.data.socials.email }}">
        {{- site.data.socials.email }}
        <span aria-hidden="true">↗</span></a
      >
    </div>
  </header>

  <section class="home-section" aria-labelledby="interests-title">
    <div class="section-heading">
      <p class="eyebrow">01 / Research interests</p>
      <h2 id="interests-title">Theory into practice.</h2>
    </div>
    <div class="interest-grid">
      <div>
        <span class="interest-index">01</span>
        <h3>Optimization</h3>
        <p>Mathematical modeling, combinatorial problems, and algorithms for real-world decisions.</p>
      </div>
      <div>
        <span class="interest-index">02</span>
        <h3>Applied mathematics</h3>
        <p>Analysis, differential equations, and the mathematical foundations of computation.</p>
      </div>
      <div>
        <span class="interest-index">03</span>
        <h3>Machine learning</h3>
        <p>Learning from data through the lens of mathematics and computational methods.</p>
      </div>
    </div>
  </section>

  {% if page.latest_posts.enabled %}
    <section class="home-section" aria-labelledby="notes-title">
      <div class="section-heading section-heading-split">
        <div>
          <p class="eyebrow">02 / From the notebook</p>
          <h2 id="notes-title">Recent writing.</h2>
        </div>
        <a href="{{ '/blog/' | relative_url }}">All notes <span aria-hidden="true">↗</span></a>
      </div>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}

  {% assign selected_projects = site.projects | sort: 'importance' %}
  {% if selected_projects.size > 0 %}
    <section class="home-section" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="eyebrow">03 / Selected work</p>
        <h2 id="work-title">Ideas, implemented.</h2>
      </div>
      {% for project in selected_projects limit: 2 %}
        <a class="selected-project" href="{{ project.url | relative_url }}">
          <div>
            <h3>{{ project.title }}</h3>
            <p>{{ project.description }}</p>
          </div>
          <span aria-hidden="true">↗</span></a
        >
      {% endfor %}
    </section>
  {% endif %}

  {% if page.announcements.enabled and site.news.size > 0 %}
    <section class="home-section home-news" aria-labelledby="news-title">
      <div class="section-heading">
        <p class="eyebrow">04 / Updates</p>
        <h2 id="news-title">Along the way.</h2>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}
</div>
