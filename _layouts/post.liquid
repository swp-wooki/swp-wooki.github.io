---
layout: default
---
{% if page._styles %}
  <style>
    {{ page._styles }}
  </style>
{% endif %}
{% assign is_note = false %}
{% if page.collection == 'posts' %}{% assign is_note = true %}{% endif %}
<div class="post reading-article">
  <header class="post-header article-header">
    {% if is_note -%}
      <a class="back-link" href="{{ '/blog/' | relative_url }}">← Research notes</a>
    {%- endif %}
    {% if page.topic_label != blank %}
      <p class="eyebrow">{{ page.topic_label }}</p>
    {% endif %}
    <h1 class="post-title">{{ page.title | escape }}</h1>
    {% if page.description %}
      <p class="article-deck">{{ page.description | escape }}</p>
    {% endif %}
    <div class="article-meta">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %d, %Y' }}</time>
      {% if page.reading_minutes -%}
        <span>About {{ page.reading_minutes }} min read</span>
      {%- endif %}
      <span>
        {{- page.author | default: site.first_name -}}
        {%- unless page.author %} {{ site.last_name }}{% endunless -%}
      </span>
      {% if page.last_updated -%}
        <span>Updated {{ page.last_updated | date: '%b %d, %Y' }}</span>
      {%- endif %}
    </div>
    {% if is_note %}
      <div class="article-tools">
        <a href="#discussion">Questions &amp; corrections</a>
        <button type="button" data-copy-link hidden>Copy link</button>
        <span class="copy-status" role="status" aria-live="polite"></span>
      </div>
    {% endif %}
  </header>

  {% if page.reading_path %}
    <details class="reading-path">
      <summary>
        <span>
          {{- page.reading_path.title }}
          <span class="muted">/ Note {{ page.reading_path.position }} of {{ page.reading_path.total }}</span></span
        ><span class="path-action">Contents</span>
      </summary>
      <ol>
        {% for chapter in page.reading_path.chapters %}
          <li>
            {% if chapter.url == page.url -%}
              <span aria-current="page">{{ chapter.title | escape }}</span>
            {%- else -%}
              <a href="{{ chapter.url | relative_url }}">{{ chapter.title | escape }}</a>
            {%- endif %}
          </li>
        {% endfor %}
      </ol>
    </details>
  {% endif %}

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <details id="table-of-contents">
        <summary>On this page</summary>
        {% toc %}
      </details>
    {% endif %}
    <div id="markdown-content">{{ content }}</div>
  </article>

  {% if page.tags.size > 0 %}
    <nav class="article-tags" aria-label="Related topics">
      {% for tag in page.tags -%}
        <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">{{ tag | replace: '-', ' ' }}</a>
      {%- endfor %}
    </nav>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">{% bibliography --group_by none --cited_in_order %}</div>
  {% endif %}

  {% if page.reading_path.previous or page.reading_path.next %}
    <nav class="sequence-nav" aria-label="Continue this series">
      {% if page.reading_path.previous -%}
        <a href="{{ page.reading_path.previous.url | relative_url }}"
          ><span>← Previous note</span><strong>{{ page.reading_path.previous.title }}</strong></a
        >
      {%- endif %}
      {% if page.reading_path.next -%}
        <a href="{{ page.reading_path.next.url | relative_url }}"
          ><span>Next note →</span><strong>{{ page.reading_path.next.title }}</strong></a
        >
      {%- endif %}
    </nav>
  {% endif %}

  {% if site.related_blog_posts.enabled and page.related_posts != false %}{% include related_posts.liquid %}{% endif %}

  {% if is_note %}
    <section class="discussion-section" id="discussion" aria-labelledby="discussion-title">
      <h2 id="discussion-title">Questions &amp; corrections</h2>
      <p>For questions or corrections about this post, use GitHub Discussions or email.</p>
      {% capture discussion_query %}repo:{{ site.giscus.repo }} "{{ page.url }}"{% endcapture %}
      {% capture discussion_body %}Regarding [{{ page.title }}]({{ page.url | absolute_url }}){% endcapture %}
      {% capture email_subject %}Regarding: {{ page.title }}{% endcapture %}
      <div class="discussion-links">
        <a href="{{ site.discussion_url }}?discussions_q={{ discussion_query | url_encode }}">View discussion ↗</a>
        <a href="{{ site.discussion_url }}/new?category=general&amp;title={{ page.title | url_encode }}&amp;body={{ discussion_body | url_encode }}"
          >Start a discussion ↗</a
        >
        <a href="mailto:{{ site.data.socials.email }}?subject={{ email_subject | url_encode }}&amp;body={{ page.url | absolute_url | url_encode }}"
          >Email a correction</a
        >
      </div>
      <p class="discussion-note">Public discussions use a GitHub account. Email is always welcome.</p>
      {% if site.giscus.enabled and page.giscus_comments != false %}{% include giscus.liquid %}{% endif %}
    </section>
    <script defer src="{{ '/assets/js/article.js' | relative_url | bust_file_cache }}"></script>
  {% endif %}
</div>
