---
layout: default
---
{% assign archive_title = page.title | replace: '-', ' ' | capitalize %}
{% for group in site.data.blog_categories -%}
  {%- if group.slug == page.title %}{% assign archive_title = group.title %}{% endif -%}
  {%- for child in group.children -%}
    {%- if child.slug == page.title %}{% assign archive_title = child.title %}{% endif -%}
  {%- endfor -%}
{%- endfor %}
<div class="post archive-page">
  <header class="post-header">
    <a class="back-link" href="{{ '/blog/' | relative_url }}">← Research notes</a>
    <p class="eyebrow">
      {% if page.type == 'year' %}Year in review{% else %}Browse the notebook{% endif %}
    </p>
    <h1 class="post-title">
      {% if page.type == 'year' %}{{ page.date | date: '%Y' }}{% else %}{{ archive_title }}{% endif %}
    </h1>
    <p class="post-description">{{ page.documents.size }} entries in this archive.</p>
  </header>
  <div class="note-list">
    {% assign documents = page.documents | sort: 'date' | reverse %}
    {% for document in documents %}
      <article class="note-row">
        <time datetime="{{ document.date | date_to_xmlschema }}">{{ document.date | date: '%b %d, %Y' }}</time>
        <div>
          <h2>
            <a href="{% if document.redirect %}{{ document.redirect | relative_url }}{% else %}{{ document.url | relative_url }}{% endif %}">
              {{- document.title | escape -}}
            </a>
          </h2>
          {% if document.description %}
            <p>{{ document.description | escape }}</p>
          {% endif %}
        </div>
        {% if document.reading_minutes -%}
          <span class="note-reading-time">{{ document.reading_minutes }} min read</span>
        {%- endif %}
      </article>
    {% endfor %}
  </div>
</div>
